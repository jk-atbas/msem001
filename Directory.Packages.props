<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- StyleCop: neueste 1.3er-Version (die alte Stable 1.1.118 versteht modernes C# nicht) -->
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>

  <ItemGroup Label="Service">
    <PackageVersion Include="EnvironmentAbstractions" Version="5.0.0" />
    <PackageVersion Include="EnvironmentAbstractions.BannedApiAnalyzer" Version="5.0.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="23.0.0" />
    <PackageVersion Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="EnvironmentAbstractions.TestHelpers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Testably.Abstractions.Testing" Version="8.0.0" />
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.84.0" />
    <PackageVersion Include="TUnit.Mocks" Version="1.84.0" />
    <PackageVersion Include="TUnit.Mocks.Logging" Version="1.84.0" />
  </ItemGroup>
</Project>
