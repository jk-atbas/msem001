{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Msem001.Watchdog"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%PROGRAMDATA%\\Msem001Watchdog\\logs\\watchdog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({ThreadId}) {SourceContext} [{EventId}]: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%PROGRAMDATA%\\Msem001Watchdog\\logs\\watchdog-.clef",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },
  "Watchdog": {
    "Disk": {
      "DriveName": "C:\\",
      "CleanupThresholdGb": 50,
      "PodmanResetThresholdGb": 200,
      "ErrorUsagePercent": 90,
      "CriticalUsagePercent": 95,
      "CheckInterval": "00:05:00",
      "MaintenanceCooldown": "02:00:00",
      "ImmediateMaintenanceThresholdGb": 10,
      "UsageAlertRepeatInterval": "06:00:00"
    },
    "Memory": {
      "Enabled": true,
      "ErrorUsagePercent": 90,
      "CriticalUsagePercent": 95,
      "CheckInterval": "00:01:00",
      "SustainedDuration": "00:05:00",
      "UsageAlertRepeatInterval": "06:00:00"
    },
    "Schedule": {
      "NightlyPreCheckTime": "20:45"
    },
    "Podman": {
      "Executable": "podman",
      "MachineName": "podman-machine-default",
      "DockerApiPipeName": "docker_engine",
      "StartupDelay": "00:01:00",
      "CheckInterval": "00:02:00",
      "FailureThreshold": 2,
      "RepairRetryInterval": "00:30:00",
      "RepairDrainTimeout": "00:10:00",
      "ProbeTimeout": "00:00:15",
      "CommandTimeout": "00:01:00",
      "StartTimeout": "00:05:00",
      "ProxySettleTime": "00:00:20"
    },
    "Containers": {
      "Enabled": true,
      "CheckInterval": "00:10:00",
      "MaxRunTime": "01:00:00",
      "StopTimeout": "00:00:10",
      "ExcludedNamePrefixes": []
    },
    "Scripts": {
      "PowerShellExecutable": "powershell.exe",
      "ScriptsDirectory": "scripts",
      "CleanupScript": "Clean-JenkinsWorkspace.ps1",
      "CleanupTimeout": "00:30:00",
      "PodmanResetScript": "Reset-PodmanMachine.ps1",
      "PodmanResetArguments": [],
      "PodmanResetTimeout": "00:30:00"
    },
    "JenkinsAgent": {
      "Enabled": true,
      "JavaExecutable": "java",
      "AgentJarPath": "C:\\jenkins\\agent.jar",
      "ControllerUrl": "http://10.24.9.62:8080/",
      "Secret": "",
      "AgentName": "einarbeitungs-laptop",
      "WorkDir": "C:\\jenkins",
      "UseWebSocket": true,
      "StopTimeout": "00:00:30",
      "StartupGracePeriod": "00:00:15",
      "ApiUser": "",
      "ApiToken": "",
      "ApiTimeout": "00:00:15",
      "DrainTimeout": "01:00:00",
      "DrainPollInterval": "00:00:30"
    },
    "Mail": {
      "Enabled": true,
      "Host": "in-v3.mailjet.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "From": "msem001-watchdog",
      "AddressSuffix": "@atbas.de",
      "Recipients": [],
      "SubjectPrefix": "[MSEM001 Watchdog]",
      "BatchDelay": "00:00:30",
      "MaxEntriesPerMail": 50,
      "SendAttempts": 3,
      "RetryDelay": "00:00:30",
      "Timeout": "00:00:30"
    }
  }
}
